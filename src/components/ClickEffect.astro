---
/*
 * 点击特效组件。
 *
 * 设计要点：容器节点始终输出，由脚本读取 data-enabled / data-effect 决定行为。
 * 旧写法用 th:if 依赖配置值严格等于布尔 true，一旦配置未落库、值不是布尔，
 * 或 Thymeleaf 求值把属性移除，节点就不会渲染 —— 特效静默失效且无任何报错。
 *
 * 特效元素统一挂到 body 下的 .wi-click-fx-layer：
 * .wi-main 是独立的层叠上下文（z-index:1），留在里面会被导航栏/页脚遮住。
 *
 * spawn() 里必须强制回流，否则新节点的初态与终态在同一帧被合并，
 * transition 不会触发，表现同样是"点了没反应"。
 */
---

<div
  id="wi-click-effect"
  hidden
  th:attr="data-effect=${theme.config?.style?.click_effect_type ?: 'values'},data-enabled=${theme.config?.style?.click_effect_enabled}"
></div>

<script is:inline th:inline="none">
  (function () {
    var cfg = document.getElementById("wi-click-effect");
    if (!cfg) return;

    if ((cfg.getAttribute("data-enabled") || "").trim() !== "true") return;

    var effect = (cfg.getAttribute("data-effect") || "").trim();
    if (!effect) effect = "values";
    if (effect === "off") return;

    /* 社会主义核心价值观 */
    var CORE_VALUES = [
      "富强", "民主", "文明", "和谐",
      "自由", "平等", "公正", "法治",
      "爱国", "敬业", "诚信", "友善"
    ];

    var RANDOM_COLORS = [
      "#ff6b6b", "#f06595", "#cc5de8", "#845ef7",
      "#5c7cfa", "#339af0", "#22b8cf", "#20c997",
      "#51cf66", "#94d82d", "#fcc419", "#ff922b"
    ];

    function pick(list) {
      return list[Math.floor(Math.random() * list.length)];
    }

    /*
     * 特效层统一挂在 body 下：
     * .wi-main 自身是层叠上下文（z-index:1），留在里面会被导航栏/页脚遮住；
     * 同时该层 position:fixed 且铺满视口，内部 fixed 子元素的
     * left/top 仍等价于 clientX/clientY。
     */
    var layer = document.createElement("div");
    layer.className = "wi-click-fx-layer";
    document.body.appendChild(layer);

    /* 创建单个 DOM 元素并加入特效层，返回后即可设置终态样式 */
    function spawn(el, x, y) {
      el.style.left = x + "px";
      el.style.top = y + "px";
      layer.appendChild(el);
      /*
       * 强制回流：新插入的元素若在同一帧内被改写 transform/opacity，
       * 浏览器会把初态与终态合并，transition 不会触发 —— 表现为"没有任何效果"。
       */
      void el.offsetWidth;
      return el;
    }

    function removeLater(el, delay) {
      setTimeout(function () {
        if (el.parentNode) el.parentNode.removeChild(el);
      }, delay);
    }

    /* ========== 1. 社会主义核心价值观 ========== */
    function spawnValueText(x, y) {
      var el = document.createElement("span");
      el.className = "wi-click-fx wi-click-fx--text";
      el.textContent = pick(CORE_VALUES);
      el.style.color = pick(RANDOM_COLORS);
      spawn(el, x, y);
      removeLater(el, 1300);
    }

    /* ========== 2. 随机彩色爱心 ========== */
    function spawnHeart(x, y) {
      var el = document.createElement("span");
      el.className = "wi-click-fx wi-click-fx--heart";
      el.innerHTML = "&#10084;";
      el.style.color = pick(RANDOM_COLORS);
      spawn(el, x, y);
      el.style.transform = "translate(calc(-50% + " + ((Math.random() - 0.5) * 80).toFixed(1) + "px), -90px) scale(0.3)";
      el.style.opacity = "0";
      removeLater(el, 1100);
    }

    /* ========== 3. 烟花 ========== */
    function spawnFirework(x, y) {
      var count = 18;
      var color = pick(RANDOM_COLORS);
      for (var i = 0; i < count; i++) {
        var el = document.createElement("span");
        el.className = "wi-click-fx wi-click-fx--spark";
        el.style.background = color;
        el.style.boxShadow = "0 0 6px " + color;
        var angle = (Math.PI * 2 * i) / count;
        var dist = 40 + Math.random() * 34;
        spawn(el, x, y);
        el.style.transform = "translate(calc(-50% + " + (Math.cos(angle) * dist).toFixed(1) + "px), calc(-50% + " + (Math.sin(angle) * dist).toFixed(1) + "px)) scale(0)";
        el.style.opacity = "0";
        removeLater(el, 900);
      }
    }

    /* ========== 4. 烟花波纹 ========== */
    function spawnRipple(x, y) {
      var color = pick(RANDOM_COLORS);
      for (var r = 0; r < 2; r++) {
        var el = document.createElement("span");
        el.className = "wi-click-fx wi-click-fx--ripple";
        el.style.borderColor = color;
        spawn(el, x, y);
        (function (el, delay) {
          setTimeout(function () {
            el.style.transform = "translate(-50%, -50%) scale(4)";
            el.style.opacity = "0";
            removeLater(el, 700);
          }, delay);
        })(el, r * 160);
        removeLater(el, 160 + 900);
      }
    }

    /* ========== 5. 粒子 ========== */
    function spawnParticles(x, y, n) {
      n = n || 10;
      for (var i = 0; i < n; i++) {
        var el = document.createElement("span");
        el.className = "wi-click-fx wi-click-fx--particle";
        el.style.background = pick(RANDOM_COLORS);
        spawn(el, x, y);
        el.style.transform = "translate(calc(-50% + " + ((Math.random() - 0.5) * 60).toFixed(1) + "px), calc(-50% + " + ((Math.random() - 0.5) * 60 - 20).toFixed(1) + "px)) scale(0)";
        el.style.opacity = "0";
        removeLater(el, 800);
      }
    }

    /* ========== 6. 星星 ========== */
    function spawnStar(x, y) {
      var el = document.createElement("span");
      el.className = "wi-click-fx wi-click-fx--star";
      el.innerHTML = "&#9733;";
      el.style.color = pick(RANDOM_COLORS);
      spawn(el, x, y);
      el.style.transform = "translate(calc(-50% + " + ((Math.random() - 0.5) * 50).toFixed(1) + "px), calc(-50% + " + ((Math.random() - 0.5) * 50 - 30).toFixed(1) + "px)) scale(1.6)";
      el.style.opacity = "0";
      removeLater(el, 900);
    }

    /* 点击分发 */
    var clickHandlers = {
      "values": spawnValueText,
      "hearts": spawnHeart,
      "fireworks": spawnFirework,
      "ripples": spawnRipple,
      "particles": function (x, y) { spawnParticles(x, y, 10); },
      "stars": spawnStar
    };

    /* 拖尾效果 */
    function spawnTrailStar(x, y) {
      var el = document.createElement("span");
      el.className = "wi-click-fx wi-click-fx--trail-star";
      el.innerHTML = "&#9733;";
      el.style.color = pick(RANDOM_COLORS);
      spawn(el, x, y);
      el.style.opacity = "0";
      removeLater(el, 700);
    }

    function spawnTrailParticle(x, y) {
      var el = document.createElement("span");
      el.className = "wi-click-fx wi-click-fx--trail-particle";
      el.style.background = pick(RANDOM_COLORS);
      spawn(el, x, y);
      el.style.opacity = "0";
      removeLater(el, 600);
    }

    var trailHandlers = {
      "star-trail": spawnTrailStar,
      "particle-trail": spawnTrailParticle
    };

    var isTrail = effect.indexOf("trail") !== -1;

    if (isTrail) {
      var handler = trailHandlers[effect];
      if (!handler) return;
      var lastX = 0;
      var lastY = 0;
      var throttling = false;
      document.addEventListener(
        "mousemove",
        function (e) {
          lastX = e.clientX;
          lastY = e.clientY;
          if (throttling) return;
          throttling = true;
          requestAnimationFrame(function () {
            throttling = false;
            handler(lastX, lastY);
          });
        },
        { passive: true }
      );
    } else {
      var handler = clickHandlers[effect];
      if (!handler) return;
      document.addEventListener(
        "click",
        function (e) {
          handler(e.clientX, e.clientY);
        },
        { passive: true }
      );
    }
  })();
</script>

<style is:global>
/* 特效层：铺满视口的固定层，统一承载所有点击/拖尾元素 */
.wi-click-fx-layer {
  position: fixed;
  inset: 0;
  z-index: 12050;
  pointer-events: none;
  overflow: hidden;
}

.wi-click-fx {
  position: fixed;
  pointer-events: none;
  will-change: transform, opacity;
  user-select: none;
}

.wi-click-fx--text {
  font-size: 18px;
  font-weight: 700;
  transform: translate(-50%, -50%);
  animation: wi-fx-text 1.2s ease-out forwards;
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.18);
}

.wi-click-fx--heart {
  font-size: 20px;
  opacity: 1;
  transition: transform 1s cubic-bezier(0.16, 1, 0.3, 1), opacity 1s ease-out;
}

.wi-click-fx--spark {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  opacity: 1;
  transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.8s ease-out;
}

.wi-click-fx--ripple {
  width: 30px;
  height: 30px;
  border: 2px solid;
  border-radius: 50%;
  transform: translate(-50%, -50%) scale(0.5);
  opacity: 0.9;
  transition: transform 0.7s ease-out, opacity 0.7s ease-out;
}

.wi-click-fx--particle {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  opacity: 1;
  transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.7s ease-out;
}

.wi-click-fx--star {
  font-size: 16px;
  opacity: 1;
  transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.8s ease-out;
}

.wi-click-fx--trail-star {
  font-size: 12px;
  transform: translate(-50%, -50%);
  opacity: 0.9;
  transition: opacity 0.6s ease-out, transform 0.6s ease-out;
}

.wi-click-fx--trail-particle {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  opacity: 0.9;
  transition: opacity 0.5s ease-out, transform 0.5s ease-out;
}

@keyframes wi-fx-text {
  0% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.5);
  }
  20% {
    opacity: 1;
    transform: translate(-50%, -80%) scale(1.1);
  }
  to {
    opacity: 0;
    transform: translate(-50%, -120%) scale(0.9);
  }
}
</style>
