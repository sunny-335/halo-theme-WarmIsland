---
import { readFileSync } from "node:fs";
import { resolve } from "node:path";

// 版本号直接读取 theme.yaml，避免与包版本不同步
function readThemeVersion() {
  try {
    const yaml = readFileSync(resolve(process.cwd(), "theme.yaml"), "utf-8");
    return yaml.match(/^\s*version:\s*"?([^"\s]+)"?/m)?.[1] ?? "";
  } catch {
    return "";
  }
}

const THEME_VERSION = readThemeVersion();
---

<footer
  th:with="showPowered=${theme.config?.footer?.footer_show_powered != false}, showTheme=${theme.config?.footer?.footer_show_theme != false}, hideRight=${showPowered == false and showTheme == false}, icpText=${theme.config?.footer?.footer_icp}, mpsText=${theme.config?.footer?.footer_mps}, showIcp=${theme.config?.footer?.footer_show_icp == true and not #strings.isEmpty(#strings.trim(icpText ?: ''))}, showMps=${theme.config?.footer?.footer_show_mps == true and not #strings.isEmpty(#strings.trim(mpsText ?: ''))}"
>
  <div class="footer-inner">
    <div class="footer-bottom" th:classappend="${hideRight} ? 'footer-bottom--center' : ''">
      <div class="footer-bottom__left">
        <span class="footer-copyright" th:if="${theme.config?.footer?.footer_copyright}" th:text="${theme.config?.footer?.footer_copyright}"></span>
        <span class="footer-copyright" th:unless="${theme.config?.footer?.footer_copyright}">
          © <th:block th:text="${#dates.format(#dates.createNow(), 'yyyy')}">2026</th:block>
          <th:block th:text="${theme.config?.basic?.owner_name ?: site.title}"></th:block>
        </span>
        <span class="footer-icp" th:if="${showIcp}">
          <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer" th:text="${#strings.trim(icpText)}"></a>
        </span>
        <span class="footer-mps" th:if="${showMps}" th:with="mpsUrl=${theme.config?.footer?.footer_mps_url ?: 'https://beian.mps.gov.cn/'}">
          <a th:href="${mpsUrl}" target="_blank" rel="noopener noreferrer">
            <svg class="footer-mps__icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2L2 7v6c0 5.5 3.8 10.7 10 12 6.2-1.3 10-6.5 10-12V7l-10-5z"></path>
              <path d="M9.5 12.5l2 2 3.5-4" stroke="#fff" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            <span th:text="${#strings.trim(mpsText)}"></span>
          </a>
        </span>
      </div>
      <div class="footer-socials" th:if="${theme.config?.footer?.footer_socials}">
        <a
          th:each="social : ${theme.config?.footer?.footer_socials}"
          th:href="${social.url}"
          th:title="${social.platform}"
          target="_blank"
          rel="noopener noreferrer"
        >
          <i th:if="${social.icon}" th:class="${social.icon}"></i>
          <span th:if="${#strings.isEmpty(social.icon)}" th:text="${social.platform}"></span>
        </a>
      </div>
      <div class="footer-bottom__right" th:if="${showPowered or showTheme}">
        <a th:if="${showPowered}" href="https://halo.run" target="_blank" rel="noopener noreferrer">Powered by Halo</a>
        <span class="footer-separator" th:if="${showPowered and showTheme}">·</span>
        <span th:if="${showTheme}">WarmIsland v{THEME_VERSION}</span>
      </div>
    </div>
    <div
      class="footer-stats"
      th:if="${theme.config?.footer?.footer_show_stats != false}"
      th:with="stats=${siteStatsFinder.getStats()}, items=${theme.config?.footer?.footer_stats_items ?: {'post','category','comment','visit'}}"
    >
      <span class="footer-stat" th:if="${#lists.contains(items, 'post')}">
        <span class="footer-stat__value" th:text="${stats.post ?: 0}">0</span>
        <span class="footer-stat__label">文章</span>
      </span>
      <span class="footer-stat" th:if="${#lists.contains(items, 'category')}">
        <span class="footer-stat__value" th:text="${stats.category ?: 0}">0</span>
        <span class="footer-stat__label">分类</span>
      </span>
      <span class="footer-stat" th:if="${#lists.contains(items, 'comment')}">
        <span class="footer-stat__value" th:text="${stats.comment ?: 0}">0</span>
        <span class="footer-stat__label">评论</span>
      </span>
      <span class="footer-stat" th:if="${#lists.contains(items, 'visit')}">
        <span class="footer-stat__value" th:text="${stats.visit ?: 0}">0</span>
        <span class="footer-stat__label">访问</span>
      </span>
      <span class="footer-stat" th:if="${#lists.contains(items, 'upvote')}">
        <span class="footer-stat__value" th:text="${stats.upvote ?: 0}">0</span>
        <span class="footer-stat__label">点赞</span>
      </span>
      <span
        class="footer-stat"
        th:if="${#lists.contains(items, 'word') and pluginFinder.available('extra-api')}"
      >
        <span class="footer-stat__value" th:text="${extraApiStatsFinder.getPostWordCount()}">0</span>
        <span class="footer-stat__label">字数</span>
      </span>
    </div>
    <div th:if="${theme.config?.footer?.footer_custom_html}" th:utext="${theme.config?.footer?.footer_custom_html}" class="footer-custom"></div>
    <div class="footer-injected">
      <halo:footer />
    </div>
  </div>
</footer>

<style>
  /*
   * 页脚不要创建高于内容的绘制层级：
   * - 之前 z-index:1 与 .wi-main 同级且靠后，会盖住内容区的弹层（如评论区翻页下拉）
   * - 渐变背景（background-image）无法参与过渡，导致深浅色切换时页脚瞬变、
   *   内容区还在渐变，看起来"不同步"；改为 background-color + 遮罩渐隐的
   *   伪色层，两者都能随 .wi-theme-transition 平滑过渡
   */
  footer {
    position: relative;
    border-top: 1px solid var(--rule);
    background-color: var(--bg);
  }

  footer::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-color: color-mix(in srgb, var(--bg) 97%, var(--accent) 3%);
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000);
    mask-image: linear-gradient(to bottom, transparent, #000);
  }

  .footer-inner {
    position: relative;
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.85rem;
    color: var(--ink-3);
    width: 100%;
  }

  .footer-bottom--center {
    justify-content: center;
  }

  .footer-bottom--center .footer-bottom__left {
    flex: none;
  }

  .footer-bottom__left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .footer-copyright {
    color: var(--ink-3);
  }

  .footer-icp a {
    color: var(--ink-3);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-icp a:hover {
    color: var(--ink-2);
  }

  .footer-mps a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--ink-3);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-mps a:hover {
    color: var(--ink-2);
  }

  .footer-mps__icon {
    flex: none;
    vertical-align: middle;
  }

  .footer-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    width: 100%;
    font-size: 0.8rem;
    color: var(--ink-3);
  }

  .footer-stat {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
  }

  .footer-stat__value {
    font-weight: 600;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }

  .footer-stat__label {
    opacity: 0.8;
  }

  .footer-socials {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }

  .footer-socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-3);
    text-decoration: none;
    font-size: 1.05rem;
    transition: color 0.15s ease;
  }

  .footer-socials a:hover {
    color: var(--ink-2);
  }

  .footer-bottom__right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .footer-bottom__right a {
    color: var(--ink-3);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-bottom__right a:hover {
    color: var(--ink-2);
  }

  .footer-separator {
    color: var(--ink-3);
    opacity: 0.5;
  }

  .footer-custom {
    width: 100%;
    text-align: center;
    font-size: 0.85rem;
    color: var(--ink-3);
    line-height: 1.8;
  }

  .footer-custom :global(a),
  .footer-custom :global(p),
  .footer-custom :global(span) {
    display: inline;
    margin-inline: 0.25em;
  }

  .footer-custom :global(a) {
    color: var(--ink-3);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-custom :global(a):hover {
    color: var(--ink-2);
  }

  .footer-custom :global(img) {
    display: inline-block;
    vertical-align: middle;
    border-radius: 4px;
  }

  .footer-custom :global(div) {
    text-align: center;
  }

  .footer-injected {
    width: 100%;
    text-align: center;
    font-size: 0.85rem;
    color: var(--ink-3);
    line-height: 1.8;
  }

  .footer-injected :global(a),
  .footer-injected :global(p),
  .footer-injected :global(span) {
    display: inline;
    margin-inline: 0.25em;
  }

  .footer-injected :global(a) {
    color: var(--ink-3);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-injected :global(a):hover {
    color: var(--ink-2);
  }

  .footer-injected :global(img) {
    display: inline-block;
    vertical-align: middle;
    border-radius: 4px;
  }

  .footer-injected :global(div) {
    text-align: center;
  }

  @media (max-width: 768px) {
    .footer-bottom {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .footer-bottom__left {
      justify-content: center;
    }

    .footer-bottom__right {
      justify-content: center;
    }

    .footer-custom,
    .footer-injected {
      font-size: 0.75rem;
    }
  }
</style>
