{
  "version": "1.1.6",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "nodemon --config nodemon.json --exec 'astro build'",
    "build": "astro build && node -e \"const fs=require('fs');const src='templates/logo.png';const dst='templates/assets/logo.png';if(fs.existsSync(src)){fs.copyFileSync(src,dst)}\"",
    "astro": "astro",
    "format": "prettier --write ."
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-astro"
    ],
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      }
    ]
  },
  "dependencies": {
    "astro": "^6.1.4",
    "lightgallery": "^2.9.0"
  },
  "devDependencies": {
    "@halo-dev/theme-package-cli": "^1.1.1",
    "nodemon": "^3.1.14",
    "prettier": "3.8.1",
    "prettier-plugin-astro": "0.14.1",
    "sass": "^1.87.0"
  }
}
